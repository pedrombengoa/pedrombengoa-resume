---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../Section.astro';
import EntryCard from '../EntryCard.astro';
import Hero from './Hero.astro';
import Experience from './Experience.astro';
import Skills from './Skills.astro';
import { site } from '../../config/site';
import { localizedPath, useTranslations, type Lang } from '../../i18n/utils';
import { getExperience, getLocalizedEntries, getProfile, getRecommendations, getSkills } from '../../lib/content';
import { profilePageSchema } from '../../lib/structured-data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const [profile, jobs, skills, projects, caseStudies, recommendations] = await Promise.all([
  getProfile(),
  getExperience(),
  getSkills(),
  getLocalizedEntries('projects', lang),
  getLocalizedEntries('caseStudies', lang),
  getRecommendations(),
]);
const renderedRecs = await Promise.all(recommendations.map(async (r) => ({ data: r.data, Content: (await render(r)).Content })));
const r = profile.reinvention;
---

<BaseLayout
  lang={lang}
  path="/"
  type="profile"
  title={t('meta.homeTitle')}
  description={t('meta.homeDescription')}
  jsonLd={[profilePageSchema(lang, Astro.site!)]}
>
  <Hero lang={lang} profile={profile} />

  <Section id="about" eyebrow={t('section.about.eyebrow')} title={t('section.about.title')}>
    <div class="max-w-3xl space-y-5 text-lg">
      {profile.about[lang].map((p) => <p>{p}</p>)}
    </div>
  </Section>

  <Section id="reinvention" eyebrow={t('section.reinvention.eyebrow')} title={t('section.reinvention.title')}>
    <div class="max-w-3xl space-y-5 text-lg">
      <p>{r.intro[lang]}</p>
      <p class="text-muted">{r.listLead[lang]}</p>
    </div>
    <ol class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        r.transformations.map((tr, i) => (
          <li class:list={['card flex flex-wrap items-center gap-x-3 gap-y-1 px-5 py-4', i === r.transformations.length - 1 && 'border-accent sm:col-span-2']}>
            <span class="font-mono text-xs text-muted" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="text-muted line-through decoration-line decoration-2">{tr.from[lang]}</span>
            <span class="text-accent" aria-hidden="true">→</span>
            <span class="font-semibold">{tr.to[lang]}</span>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 max-w-3xl text-lg">{r.closing[lang]}</p>
    <h3 class="mt-10 font-mono text-sm text-muted">{t('section.reinvention.evidence')}</h3>
    <ul class="mt-3 flex flex-col gap-2">
      {
        caseStudies.map(({ entry, slug }) => (
          <li>
            <a class="link" href={localizedPath(lang, `/case-studies/${slug}/`)}>
              {entry.data.shift}
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="experience" eyebrow={t('section.experience.eyebrow')} title={t('section.experience.title')}>
    <Experience lang={lang} jobs={jobs} />
  </Section>

  <Section id="skills" eyebrow={t('section.skills.eyebrow')} title={t('section.skills.title')}>
    <Skills lang={lang} groups={skills} />
  </Section>

  <Section id="projects" eyebrow={t('section.projects.eyebrow')} title={t('section.projects.title')}>
    <ul class="grid gap-5 md:grid-cols-3">
      {
        projects.map(({ entry, slug }) => (
          <li>
            <EntryCard
              href={localizedPath(lang, `/projects/${slug}/`)}
              title={entry.data.title}
              summary={entry.data.summary}
              meta={`${entry.data.kind} · ${t(`project.status.${entry.data.status}`)}`}
              tags={entry.data.tech.slice(0, 4)}
              cta={t('card.readMore')}
            />
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="case-studies" eyebrow={t('section.caseStudies.eyebrow')} title={t('section.caseStudies.title')}>
    <ul class="grid gap-5 md:grid-cols-2">
      {
        caseStudies.map(({ entry, slug }) => (
          <li>
            <EntryCard
              href={localizedPath(lang, `/case-studies/${slug}/`)}
              title={entry.data.title}
              summary={entry.data.summary}
              meta={entry.data.shift}
              cta={t('card.readMore')}
            />
          </li>
        ))
      }
    </ul>
  </Section>

  {
    renderedRecs.length > 0 && (
      <Section id="recommendations" eyebrow={t('section.recommendations.eyebrow')} title={t('section.recommendations.title')}>
        <ul class="grid gap-5 md:grid-cols-2">
          {renderedRecs.map(({ data, Content }) => (
            <li>
              <figure class="card h-full p-6" lang={data.lang}>
                <blockquote class="prose text-[1rem]">
                  <Content />
                </blockquote>
                <figcaption class="mt-5 border-t border-line pt-4 text-sm">
                  <span class="font-semibold">
                    {data.url ? (
                      <a class="link" href={data.url} rel="noopener" target="_blank">
                        {data.name}
                      </a>
                    ) : (
                      data.name
                    )}
                  </span>
                  <span class="block text-muted">{data.role}</span>
                  {(data.relationship || data.date) && (
                    <span class="block font-mono text-xs text-muted">{[data.relationship, data.date].filter(Boolean).join(' · ')}</span>
                  )}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section id="education" eyebrow={t('section.education.eyebrow')} title={t('section.education.title')}>
    <div class="grid gap-5 md:grid-cols-2">
      <div class="card p-6">
        <h3 class="text-lg font-semibold">{profile.education.degree[lang]}</h3>
        <p class="mt-1">{profile.education.school}</p>
        <p class="mt-3 text-sm text-muted">{profile.education.note[lang]}</p>
      </div>
      <div class="card p-6">
        <ul class="space-y-3">
          {
            profile.languages.map((l) => (
              <li class="flex items-baseline justify-between gap-4">
                <span class="font-semibold">{l.name[lang]}</span>
                <span class="text-right font-mono text-sm text-muted">{l.level[lang]}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <Section id="contact" eyebrow={t('section.contact.eyebrow')} title={t('section.contact.title')}>
    <p class="max-w-2xl text-lg">{t('section.contact.text')}</p>
    <ul class="mt-8 flex flex-wrap gap-3">
      <li>
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-on-accent transition-opacity hover:opacity-90"
        >
          {t('section.contact.email')} · {site.email}
        </a>
      </li>
      <li>
        <a
          href={site.linkedin}
          rel="me noopener"
          target="_blank"
          class="inline-flex items-center rounded-full border border-line px-5 py-2.5 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
        >
          {t('section.contact.linkedin')}
        </a>
      </li>
      {
        site.github && (
          <li>
            <a
              href={site.github}
              rel="me noopener"
              target="_blank"
              class="inline-flex items-center rounded-full border border-line px-5 py-2.5 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
            >
              {t('section.contact.github')}
            </a>
          </li>
        )
      }
    </ul>
  </Section>
</BaseLayout>
