---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizedPath, useTranslations, type Lang } from '../../i18n/utils';
import { breadcrumbSchema } from '../../lib/structured-data';

interface Neighbor {
  href: string;
  title: string;
}

interface Props {
  lang: Lang;
  path: string;
  title: string;
  summary: string;
  meta: string;
  section: { name: string; anchor: string };
  jsonLd: Record<string, unknown>;
  prev?: Neighbor;
  next?: Neighbor;
}

const { lang, path, title, summary, meta, section, jsonLd, prev, next } = Astro.props;
const t = useTranslations(lang);
const home = localizedPath(lang, '/');
const breadcrumbs = [
  { name: t('detail.breadcrumbHome'), path: home },
  { name: section.name, path: `${home}#${section.anchor}` },
  { name: title, path: localizedPath(lang, path) },
];
---

<BaseLayout
  lang={lang}
  path={path}
  type="article"
  title={`${title} — Pedro Bengoa`}
  description={summary}
  jsonLd={[jsonLd, breadcrumbSchema(breadcrumbs, Astro.site!)]}
>
  <article class="container-page pt-10 sm:pt-16">
    <nav aria-label="Breadcrumb" class="font-mono text-xs text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a class="hover:text-accent" href={breadcrumbs[0].path}>{breadcrumbs[0].name}</a></li>
        <li aria-hidden="true">/</li>
        <li><a class="hover:text-accent" href={breadcrumbs[1].path}>{breadcrumbs[1].name}</a></li>
      </ol>
    </nav>

    <header class="mt-8 max-w-3xl">
      <p class="font-mono text-sm text-accent">{meta}</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-balance sm:text-5xl">{title}</h1>
      <p class="mt-5 text-xl text-muted">{summary}</p>
    </header>

    <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <div class="prose min-w-0">
        <slot />
      </div>
      <aside class="lg:order-last">
        <div class="card space-y-6 p-6 lg:sticky lg:top-24">
          <slot name="facts" />
        </div>
      </aside>
    </div>

    <nav class="mt-16 grid gap-4 border-t border-line pt-8 sm:grid-cols-2" aria-label={section.name}>
      {
        prev ? (
          <a href={prev.href} class="group block">
            <span class="font-mono text-xs text-muted">← {t('detail.prev')}</span>
            <span class="mt-1 block font-semibold group-hover:text-accent">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={next.href} class="group block sm:text-right">
            <span class="font-mono text-xs text-muted">{t('detail.next')} →</span>
            <span class="mt-1 block font-semibold group-hover:text-accent">{next.title}</span>
          </a>
        )
      }
    </nav>
    <p class="mt-10">
      <a class="link text-sm" href={`${home}#${section.anchor}`}>← {t('detail.back')}</a>
    </p>
  </article>
</BaseLayout>
