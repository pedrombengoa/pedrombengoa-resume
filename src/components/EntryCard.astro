---
interface Props {
  href: string;
  title: string;
  summary: string;
  meta?: string;
  tags?: string[];
  cta: string;
}

const { href, title, summary, meta, tags = [], cta } = Astro.props;
---

<a href={href} class="card-link group block h-full">
  <article class="card flex h-full flex-col p-6">
    {meta && <p class="font-mono text-xs text-accent">{meta}</p>}
    <h3 class="mt-2 text-lg font-semibold tracking-tight text-balance">{title}</h3>
    <p class="mt-3 text-muted">{summary}</p>
    {
      tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }
    <p class="mt-auto pt-6 text-sm font-semibold">
      {cta} <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
    </p>
  </article>
</a>
