---
import { localizedPath, useTranslations, type Lang } from '../i18n/utils';
import { getRecommendations } from '../lib/content';
import ThemeToggle from './islands/ThemeToggle';

interface Props {
  lang: Lang;
  /** Href of the same page in the other language. */
  altHref: string;
}

const { lang, altHref } = Astro.props;
const t = useTranslations(lang);
const hasRecommendations = (await getRecommendations()).length > 0;

const tabs = [
  { path: '/', label: t('nav.home') },
  { path: '/experience/', label: t('nav.experience') },
  { path: '/skills/', label: t('nav.skills') },
  { path: '/projects/', label: t('nav.projects') },
  { path: '/case-studies/', label: t('nav.caseStudies') },
  ...(hasRecommendations ? [{ path: '/recommendations/', label: t('nav.recommendations') }] : []),
];

const current = Astro.url.pathname.replace(/^\/es(?=\/|$)/, '') || '/';
const isActive = (path: string) => (path === '/' ? current === '/' : current.startsWith(path));
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={localizedPath(lang, '/')} class="shrink-0 font-mono text-sm font-semibold tracking-tight text-fg hover:text-accent">
      pedro<span class="text-accent">.</span>bengoa
    </a>
    <nav aria-label={t('nav.label')} class="hidden h-full md:block">
      <ul class="flex h-full items-stretch gap-1 text-sm">
        {
          tabs.map((tab) => (
            <li class="flex">
              <a
                href={localizedPath(lang, tab.path)}
                aria-current={isActive(tab.path) ? 'page' : undefined}
                class="tab flex items-center px-2.5 lg:px-3"
              >
                {tab.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex shrink-0 items-center gap-2">
      <a
        href={altHref}
        hreflang={lang === 'en' ? 'es' : 'en'}
        lang={lang === 'en' ? 'es' : 'en'}
        aria-label={t('lang.switch')}
        title={t('lang.switch')}
        class="inline-flex h-9 min-w-9 items-center justify-center rounded-full border border-line px-2.5 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent"
      >
        {t('lang.switchShort')}
      </a>
      <ThemeToggle client:idle label={t('theme.toggle')} />
    </div>
  </div>
  <nav aria-label={t('nav.label')} class="border-t border-line md:hidden">
    <ul class="no-scrollbar flex h-11 snap-x items-stretch overflow-x-auto px-2 text-sm">
      {
        tabs.map((tab) => (
          <li class="flex shrink-0 snap-start">
            <a
              href={localizedPath(lang, tab.path)}
              aria-current={isActive(tab.path) ? 'page' : undefined}
              class="tab flex items-center px-3"
            >
              {tab.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
