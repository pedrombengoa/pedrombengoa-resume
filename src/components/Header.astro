---
import { localizedPath, useTranslations, type Lang } from '../i18n/utils';
import { getRecommendations } from '../lib/content';
import ThemeToggle from './islands/ThemeToggle';
import MobileMenu from './islands/MobileMenu';

interface Props {
  lang: Lang;
  /** Href of the same page in the other language. */
  altHref: string;
}

const { lang, altHref } = Astro.props;
const t = useTranslations(lang);
const home = localizedPath(lang, '/');
const hasRecommendations = (await getRecommendations()).length > 0;

const items = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#reinvention`, label: t('nav.reinvention') },
  { href: `${home}#experience`, label: t('nav.experience') },
  { href: `${home}#projects`, label: t('nav.projects') },
  { href: `${home}#case-studies`, label: t('nav.caseStudies') },
  ...(hasRecommendations ? [{ href: `${home}#recommendations`, label: t('nav.recommendations') }] : []),
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur">
  <div class="container-page relative flex h-16 items-center justify-between gap-4">
    <a href={home} class="font-mono text-sm font-semibold tracking-tight text-fg hover:text-accent">
      pedro<span class="text-accent">.</span>bengoa
    </a>
    <nav aria-label={t('nav.label')} class="hidden md:block">
      <ul class="flex items-center gap-5 text-sm text-muted">
        {
          items.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-fg">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a
        href={altHref}
        hreflang={lang === 'en' ? 'es' : 'en'}
        lang={lang === 'en' ? 'es' : 'en'}
        aria-label={t('lang.switch')}
        title={t('lang.switch')}
        class="inline-flex h-9 min-w-9 items-center justify-center rounded-full border border-line px-2.5 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent"
      >
        {t('lang.switchShort')}
      </a>
      <ThemeToggle client:idle label={t('theme.toggle')} />
      <MobileMenu client:idle items={items} menuLabel={t('nav.menu')} closeLabel={t('nav.close')} />
    </div>
  </div>
</header>
