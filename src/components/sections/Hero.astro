---
import { site } from '../../config/site';
import { localizedPath, useTranslations, type Lang } from '../../i18n/utils';
import type { getProfile } from '../../lib/content';

interface Props {
  lang: Lang;
  profile: Awaited<ReturnType<typeof getProfile>>;
}

const { lang, profile } = Astro.props;
const t = useTranslations(lang);
const facts = [
  { key: t('hero.fact.role'), value: profile.headline[lang] },
  { key: t('hero.fact.experience'), value: t('hero.fact.experienceValue') },
  { key: t('hero.fact.focus'), value: t('hero.fact.focusValue') },
  { key: t('hero.fact.location'), value: `${profile.location[lang]} · ${profile.availability[lang]}` },
];
---

<section class="container-page pt-14 sm:pt-24" aria-labelledby="hero-title">
  <div class="grid gap-12 lg:grid-cols-[1.35fr_1fr] lg:items-end">
    <div>
      <p class="font-mono text-sm text-muted">{t('hero.eyebrow')}</p>
      <h1 id="hero-title" class="mt-2 text-5xl font-bold tracking-tight sm:text-7xl">
        {site.name}<span class="text-accent">.</span>
      </h1>
      <p class="mt-4 text-xl font-medium text-muted sm:text-2xl">{profile.headline[lang]}</p>
      <p class="mt-8 max-w-2xl border-l-2 border-accent pl-4 text-xl leading-snug font-medium text-balance sm:text-2xl">
        {profile.tagline[lang]}
      </p>
      <div class="mt-8 max-w-2xl space-y-3 text-muted">
        {profile.intro[lang].map((p) => <p>{p}</p>)}
      </div>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href={localizedPath(lang, '/projects/')}
          class="inline-flex items-center rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-on-accent transition-opacity hover:opacity-90"
        >
          {t('hero.ctaWork')}
        </a>
        <a
          href="#contact"
          class="inline-flex items-center rounded-full border border-line px-5 py-2.5 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
        >
          {t('hero.ctaContact')}
        </a>
      </div>
    </div>

    <div class="card overflow-hidden font-mono text-sm" aria-label={t('hero.statusLabel')} role="group">
      <div class="flex items-center gap-1.5 border-b border-line px-4 py-3" aria-hidden="true">
        <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-accent"></span>
        <span class="ml-2 text-xs text-muted">~/pedro</span>
      </div>
      <dl class="space-y-4 p-5">
        {
          facts.map((fact) => (
            <div>
              <dt class="text-muted">
                <span class="text-accent" aria-hidden="true">$ </span>
                {fact.key}
              </dt>
              <dd class="mt-1 break-words">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
